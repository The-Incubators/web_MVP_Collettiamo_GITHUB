rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Ricevute dell'acquisto: le carica solo chi organizza la colletta. Il rendiconto pubblico usa il link con token.
    match /ricevute/{slug}/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf')
        && firestore.get(/databases/(default)/documents/collette/$(slug)).data.organizzatoreUid == request.auth.uid;
    }
  }
}
